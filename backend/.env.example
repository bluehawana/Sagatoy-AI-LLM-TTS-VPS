# Sagatoyai Backend Environment Configuration
# Copy this file to .env and update with your values

# API Security
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256

# Redis Configuration
REDIS_URL=redis://localhost:6379

# LLM Configuration
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1

# Groq LLM (primary)
# GROQ_API_KEY=your-groq-api-key-here

# OpenAI (GPT-4o mini — fast and cheap)
# OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini (premium fallback)
# GOOGLE_API_KEY=your-google-gemini-api-key-here

# Z.ai (智谱AI — LLM + STT)
# Z_AI_API_KEY=your-z-ai-api-key-here
# Z_AI_BASE_URL=https://api.z.ai/api/paas/v4
# Z_AI_MODEL=glm-5

# NVIDIA NIM (speed backup — free, very fast)
# NVIDIA_API_KEY=your-nvidia-api-key-here
# NEMOTRON_API_KEY=your-nemotron-api-key-here
# NEMOTRON_API_BASE=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=nvidia/nemotron-mini-4b-instruct

# TTS Configuration
TTS_VOICE=en-US-JennyNeural

# Logging
LOG_LEVEL=INFO

# MQTT
MQTT_ENABLED=true
MQTT_BROKER=localhost
MQTT_PORT=1883

# UDP Voice Server (Folotoy Octopus)
UDP_ENABLED=true
UDP_VOICE_PORT=8085

# Audio HTTP Server (TTS download)
AUDIO_HTTP_ENABLED=true
AUDIO_HTTP_PORT=8082
